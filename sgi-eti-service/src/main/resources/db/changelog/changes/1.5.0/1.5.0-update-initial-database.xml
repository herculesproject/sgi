<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

  <changeSet author="master" id="1.5.0-1">
    <createSequence incrementBy="1" sequenceName="peticion_evaluacion_unidad_vinculacion_seq"
      startValue="1" />
  </changeSet>

  <changeSet author="master" id="1.5.0-2">
    <createTable tableName="peticion_evaluacion_unidad_vinculacion">
      <column name="id" type="BIGINT">
        <constraints nullable="false" primaryKey="true"
          primaryKeyName="peticion_evaluacion_unidad_vinculacionPK" />
      </column>
      <column name="created_by" type="VARCHAR(255)" />
      <column name="creation_date" type="TIMESTAMP" />
      <column name="last_modified_by" type="VARCHAR(255)" />
      <column name="last_modified_date" type="TIMESTAMP" />
      <column name="peticion_evaluacion_id" type="BIGINT">
        <constraints nullable="false" />
      </column>
      <column name="unidad_vinculacion_ref" type="VARCHAR(50)">
        <constraints nullable="false" />
      </column>
    </createTable>

    <addForeignKeyConstraint baseColumnNames="peticion_evaluacion_id"
      baseTableName="peticion_evaluacion_unidad_vinculacion"
      constraintName="FK_PETICIONEVALUACIONUNIDADVINCULACION_PETICIONEVALUACION" deferrable="false"
      initiallyDeferred="false"
      referencedColumnNames="id" referencedTableName="peticion_evaluacion" />

    <addUniqueConstraint tableName="peticion_evaluacion_unidad_vinculacion"
      columnNames="peticion_evaluacion_id, unidad_vinculacion_ref"
      constraintName="UK_PETEVALUNIDADVINCULACION_PETEVALID_UNIDADVINCULACIONREF" />
  </changeSet>

  <changeSet author="master" id="1.5.0-3">
    <addColumn tableName="configuracion">
      <column name="peticion_evaluacion_unidades_vinculacion_enabled" type="boolean"
        defaultValueBoolean="false">
        <constraints nullable="false" />
      </column>
      <column name="peticion_evaluacion_inicializar_unidad_vinculacion_enabled" type="boolean"
        defaultValueBoolean="false">
        <constraints nullable="false" />
      </column>
      <column name="tipo_unidad_vinculacion_departamento_ref" type="VARCHAR(50)" />
    </addColumn>
  </changeSet>

  <changeSet author="master" id="1.5.0-4">
    <addColumn tableName="configuracion">
      <column name="peticion_evaluacion_ayuda_fecha_inicio_enabled" type="boolean"
        defaultValueBoolean="false">
        <constraints nullable="false" />
      </column>
      <column name="peticion_evaluacion_ayuda_fecha_inicio" type="CLOB" defaultValue="[]" />
      <column name="peticion_evaluacion_ayuda_resumen_enabled" type="boolean"
        defaultValueBoolean="false">
        <constraints nullable="false" />
      </column>
      <column name="peticion_evaluacion_ayuda_resumen" type="CLOB" defaultValue="[]" />
      <column name="peticion_evaluacion_ayuda_disenio_metodologico_enabled" type="boolean"
        defaultValueBoolean="false">
        <constraints nullable="false" />
      </column>
      <column name="peticion_evaluacion_ayuda_disenio_metodologico" type="CLOB" defaultValue="[]" />
      <column name="peticion_evaluacion_ayuda_tareas_enabled" type="boolean"
        defaultValueBoolean="false">
        <constraints nullable="false" />
      </column>
      <column name="peticion_evaluacion_ayuda_tareas" type="CLOB" defaultValue="[]" />
    </addColumn>
  </changeSet>

</databaseChangeLog>
